# LF everywhere, in the repo and in every checkout, whatever core.autocrlf
# says. Prettier expects LF, and CRLF files on Windows broke its check
* text=auto eol=lf

# never touch these bytes
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.pdf binary
*.mp4 binary
*.webm binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
