# Copy to .env and fill in. src/config/env.ts checks them at startup

# development | test | production
NODE_ENV=development
PORT=5005

# Postgres credentials, used by compose.yaml to create the local database
DB_USER=portfolio
DB_PASSWORD=change-me
DB_NAME=portfolio

# Must point at the database above. Keep it a plain URL with no `?schema=...`,
# Prisma doesn't need it and GUI clients like TablePlus reject it
DATABASE_URL=postgresql://portfolio:change-me@localhost:5432/portfolio

# Origin of the Next site. The API calls its /api/revalidate to refresh cached
# pages after admin edits. Required in production
WEB_ORIGIN=http://localhost:3000

# Shared with apps/web. The API sends it with revalidation requests after admin
# edits, so the site refreshes its cached pages. Must be the same in both apps,
# secret and at least 32 characters. Required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
REVALIDATE_SECRET=

# Shared with apps/web, which sends it with every contact form submission.
# The API refuses submissions without it, which also makes the client IP the
# site forwards trustworthy. Same value in both apps, secret, at least 32
# characters. Required in production. Generate one like REVALIDATE_SECRET
CONTACT_API_SECRET=

# Discord webhook that announces new contact messages. Optional: without it
# messages are still stored, and the API warns once at startup. Secret, never
# commit or log it
DISCORD_WEBHOOK_URL=

# Shared with apps/web, which sends it with every admin request. The API
# refuses /admin requests without it. Its own value, not the contact form's.
# At least 32 characters, secret. Required in production
ADMIN_API_SECRET=

# A fine-grained GitHub token for this repository with only "Actions: read and
# write", so publishing, hiding or renaming a project can start the Deploy
# workflow. Optional: without it the admin says a deploy is needed instead.
# Never needed locally
GITHUB_DEPLOY_TOKEN=
# The repository the token is for, owner/name. Defaults to this one
GITHUB_DEPLOY_REPO=qvyra/quivery-portfolio

# The admin account, read only by npm run admin:password, which creates it or
# resets its password. Use a long random password (16+ characters)
ADMIN_USERNAME=
ADMIN_PASSWORD=
