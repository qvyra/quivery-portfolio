# Copy to .env.local and fill in. All server-only, none of these reach the
# browser. lib/env.ts checks what each stage needs at startup

# Base URL of the Nest API. Required for production builds, since they
# prerender every page from it. Defaults to http://localhost:5005 in dev
API_URL=http://localhost:5005

# Public origin of this site, for canonical and Open Graph URLs. Required for
# production builds. A custom domain only changes this and WEB_ORIGIN in
# apps/backend. Defaults to http://localhost:3000
SITE_URL=http://localhost:3000

# Shared with apps/backend, which sends it to /api/revalidate to refresh cached
# pages after admin edits. Same value in both apps, at least 32 characters,
# keep it secret. Required for next start in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
REVALIDATE_SECRET=

# Shared with apps/backend. The contact form's route sends it to the API with
# every message, and the API refuses messages without it. Same value in both
# apps, at least 32 characters, keep it secret. Required for next start in
# production. Generate one like REVALIDATE_SECRET
CONTACT_API_SECRET=

# Shared with apps/backend, sent with every admin request. The API refuses
# /admin requests without it. Its own value, not the contact one. At least 32
# characters, secret. Required for next start in production
ADMIN_API_SECRET=

# Vercel Blob, where admin uploads go. Vercel sets it in production once the
# store is connected to the project. Leave it empty locally: next dev then
# saves uploads in public/uploads
BLOB_READ_WRITE_TOKEN=

# Origin of the object storage that serves uploaded media once uploads move
# there, like https://media.example.com. Leave empty while media lives in
# public/
MEDIA_ORIGIN=
