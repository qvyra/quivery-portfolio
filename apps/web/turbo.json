{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      // The build prerenders pages from the API's current content, which
      // Turbo can't see as an input, so a cached build is never replayed
      "cache": false,
      "passThroughEnv": ["WAIT_FOR_API_TIMEOUT_MS", "PUBLISHED_PROJECT_SLUGS"]
    }
  }
}
