{
  "name": "quivery-portfolio",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "npm run db:up && turbo run dev",
    "dev:lan": "npm run db:up && turbo run dev:lan",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:up": "docker compose -f apps/backend/compose.yaml up -d",
    "db:down": "docker compose -f apps/backend/compose.yaml down",
    "db:status": "docker compose -f apps/backend/compose.yaml ps",
    "db:logs": "docker compose -f apps/backend/compose.yaml logs -f",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "turbo run db:seed"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "^2.11.10",
    "typescript": "7.0.2"
  },
  "overrides": {
    "typescript-eslint": {
      "typescript": "npm:@typescript/typescript6@^6.0.2"
    },
    "@nestjs/schematics": {
      "typescript": "npm:@typescript/typescript6@^6.0.2"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.13.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
