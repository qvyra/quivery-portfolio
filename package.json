{
  "name": "quivery-portfolio",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "overrides": {
    "typescript-eslint": {
      "typescript": "npm:@typescript/typescript6@^6.0.2"
    },
    "@nestjs/schematics": {
      "typescript": "npm:@typescript/typescript6@^6.0.2"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.13.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
